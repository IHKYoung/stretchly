{
  "name": "Pauza",
  "version": "0.1.5",
  "description": "The break time reminder app",
  "type": "module",
  "scripts": {
    "dev": "npm run desktop:dev",
    "build": "npm run desktop:build",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop:dev": "npm --prefix apps/desktop run tauri:dev",
    "desktop:build": "npm --prefix apps/desktop run tauri:build",
    "site:dev": "python3 -m http.server 43210 --directory apps/site",
    "postinstall": "npm run desktop:install",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "lint": "cross-env ./node_modules/.bin/standard",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hovancik/stretchly.git"
  },
  "keywords": [
    "Pauza",
    "break",
    "time",
    "reminder"
  ],
  "author": "Clarke Young",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/hovancik/stretchly/issues"
  },
  "homepage": "https://hovancik.net/stretchly",
  "build": {
    "appId": "net.hovancik.pauza",
    "productName": "Pauza",
    "dmg": {
      "icon": "build/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 355,
          "y": 125,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 155,
          "y": 125,
          "type": "file"
        }
      ]
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSBackgroundOnly": 1,
        "LSUIElement": 1
      }
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "freebsd",
        "pacman",
        "tar.xz",
        "apk"
      ],
      "asarUnpack": "node_modules/macos-notification-state/**"
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "appx": {
      "identityName": "33881JanHovancik.pauza",
      "publisher": "CN=35004EDA-CCDD-4304-A014-784D754E043F",
      "publisherDisplayName": "Clarke Young",
      "applicationId": "Pauza",
      "displayName": "Pauza"
    },
    "win": {
      "target": [
        "nsis",
        "7z",
        "appx",
        "portable"
      ],
      "asarUnpack": [
        "node_modules/windows-notification-state/**",
        "node_modules/macos-notification-state/**"
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "standard": {
    "globals": [
      "it",
      "describe",
      "before",
      "after",
      "beforeEach",
      "afterEach",
      "Audio",
      "fetch",
      "Notification",
      "alert",
      "__electronLog"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^4.0.18",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "rimraf": "^6.1.3",
    "standard": "^17.1.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@particle/dbus-next": "^0.11.4",
    "auto-launch": "^6.0.0-rc1",
    "dompurify": "^3.3.1",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "humanize-duration": "^3.33.2",
    "i18next": "^25.8.11",
    "i18next-fs-backend": "^2.6.1",
    "luxon": "^3.7.2",
    "meeussunmoon": "^3.1.0",
    "node-desktop-idle-v2": "^1.1.22",
    "ps-list": "^9.0.0",
    "semver": "^7.7.4",
    "windows-focus-assist": "^1.4.0"
  }
}
