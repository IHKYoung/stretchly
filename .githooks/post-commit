#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! python3 scripts/record_commit_audit.py --type auto --commit HEAD; then
  echo "[post-commit] warning: failed to append commit audit record" >&2
  exit 0
fi

COMMIT_DATE="$(git show -s --format=%cs HEAD)"
AUDIT_FILE="docs/commits/${COMMIT_DATE}.md"
if [ -f "$AUDIT_FILE" ]; then
  echo "[post-commit] audit updated: $AUDIT_FILE (not staged automatically)"
fi
